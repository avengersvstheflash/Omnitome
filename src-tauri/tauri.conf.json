{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnitome",
  "version": "1.0.0",
  "identifier": "com.omnitome.app",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Omnitome",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Omnitome",
        "url": "splashscreen.html",
        "width": 450,
        "height": 300,
        "center": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../resources/sidecar.7z": "sidecar.7z",
      "../resources/backend-runtime": "backend",
      "../resources/node": "node"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "none",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "hooks.nsh"
      }
    }
  }
}
