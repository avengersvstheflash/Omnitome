{
  "name": "omnitome",
  "version": "1.1.0",
  "description": "A local-first neural reading library with loss-bounded, provenance-aware semantic compression, deterministic vector attribution, and on-device speech synthesis.",
  "main": "backend/server.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "node backend/server.js",
    "start": "node backend/server.js",
    "test": "node scripts/run-all-tests.js",
    "db:reset": "node -e \"require('./backend/db/database').resetAndSeedDatabase(); console.log('Database reset and seeded successfully.');\"",
    "db:seed": "node -e \"require('./backend/db/database').resetAndSeedDatabase(); console.log('Database reset and seeded successfully.');\"",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sounds:generate": "node tools/sound-design/generate.mjs --write --config tools/sound-design/profiles.json --out frontend/public/sounds",
    "sounds:verify": "node tools/sound-design/generate.mjs --check --config tools/sound-design/profiles.json --out frontend/public/sounds",
    "sounds:test": "node --test tools/sound-design/generator.test.mjs",
    "samples:process": "node tools/process_samples.mjs",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@huggingface/transformers": "^4.3.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "iconv-lite": "^0.7.3",
    "jschardet": "^4.0.0",
    "multer": "^2.3.0",
    "pdfjs-dist": "^6.3.289",
    "tar": "^7.5.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5"
  }
}
